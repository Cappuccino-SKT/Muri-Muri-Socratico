{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar (C)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Compilar e executar (C)",
            "type": "shell",
            "command": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "Compilar (C)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "clear": false
            }
        }
    ]
}
